        <fuelTanks>
        <fuelTank uID="tank_corrupt">
            <name>Corrupt tank</name>
            <description>Test case exception handling</description>
            <parentUID>SimpleFuselage</parentUID>
            <transformation />
            <vessels>
              <vessel uID="vessel_corrupt_geometry1">
                <name>Vessel with wrong geometry</name>
                <transformation />
                <cylinderRadius>0.4</cylinderRadius>
                <cylinderLength>1.</cylinderLength>
              </vessel>
                <vessel uID="vessel_corrupt_geometry2">
                    <name>Vessel 2 with wrong geometry</name>
                    <transformation />
                    <cylinderLength>1.</cylinderLength>
                    <domeType>
                        <ellipsoid>
                            <halfAxisFraction>1</halfAxisFraction>
                        </ellipsoid>
                    </domeType>
                </vessel>
              <vessel uID="vessel_corrupt_ellipsoid">
                <name>Vessel with negative ax ratio</name>
                <transformation />
                <cylinderRadius>1</cylinderRadius>
                <cylinderLength>1</cylinderLength>
                <domeType>
                  <ellipsoid>
                    <halfAxisFraction>-1</halfAxisFraction>
                  </ellipsoid>
                </domeType>
              </vessel>
              <vessel uID="vessel_corrupt_torispherical1">
                <name>Vessel with too small dish radius</name>
                <transformation />
                <cylinderRadius>1</cylinderRadius>
                <cylinderLength>1</cylinderLength>
                <domeType>
                  <torispherical>
                    <dishRadius>0.5</dishRadius>
                    <knuckleRadius>0.1</knuckleRadius>
                  </torispherical>
                </domeType>
              </vessel>
              <vessel uID="vessel_corrupt_torispherical2">
                <name>Vessel with too large knuckle radius</name>
                <transformation />
                <cylinderRadius>1</cylinderRadius>
                <cylinderLength>1</cylinderLength>
                <domeType>
                  <torispherical>
                    <dishRadius>1.5</dishRadius>
                    <knuckleRadius>1.5</knuckleRadius>
                  </torispherical>
                </domeType>
              </vessel>
              <vessel uID="vessel_corrupt_isotensoid">
                <name>Vessel with too large polar opening radius</name>
                <transformation />
                <cylinderRadius>1</cylinderRadius>
                <cylinderLength>1</cylinderLength>
                <domeType>
                  <isotensoid>
                    <polarOpeningRadius>1.5</polarOpeningRadius>
                  </isotensoid>
                </domeType>
              </vessel>
              <vessel uID="vessel_corrupt_negative_radius">
                <name>Vessel with negative radius</name>
                <transformation />
                <cylinderRadius>-1</cylinderRadius>
                <cylinderLength>1</cylinderLength>
                <domeType>
                  <isotensoid>
